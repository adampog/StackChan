# Copy to .env and edit, then run ./render-config.sh
#
# Where the xiaozhi server itself runs (the box that runs docker compose).
# Usually nuc3080 too. Use an IP if mDNS/hostnames don't resolve on the robot.
XIAOZHI_HOST=192.168.1.214
XIAOZHI_WS_PORT=8000
XIAOZHI_HTTP_PORT=8003

# Your local LLM. Any OpenAI-compatible endpoint works. The default is Strata
# (llama.cpp-style) on nuc3080:8080. Others:
#   Ollama     http://nuc3080:11434/v1
#   LM Studio  http://nuc3080:1234/v1
# If the name doesn't resolve inside the container, use the LAN IP or
# http://host.docker.internal:8080/v1 (mapped in docker-compose.yml).
# LLM_TYPE: llamacpp for Strata / llama-server, openai for Ollama, LM Studio, vLLM.
LLM_TYPE=llamacpp
# Use the LAN IP: inside the container the hostname can resolve to an
# unreachable IPv6 address.
LLM_URL=http://192.168.1.214:8080/v1
LLM_MODEL=qwen3.8-flash-next-iq2_xs
# Strata needs its API key for requests from other machines (and likely from a
# container). Put the real key in .env only; .env is git-ignored.
LLM_API_KEY=changeme
# off = don't reason before answering (0.3 s instead of 2.5 s on nuc3080).
# keep = leave the model's default.
LLM_THINKING=off

# Vision (camera questions). Defaults to the same local model.
VISION_URL=http://192.168.1.214:8080/v1
VISION_MODEL=qwen3.8-flash-next-iq2_xs

# --- Which backend each piece uses ---------------------------------------
# Everything is local by default. Switch on the fly, no reflash:
#   ./switch.sh status
#   ./switch.sh llm claude       takes effect on the next sentence, no restart
#   ./switch.sh tts cloud        (asr | tts) (local | cloud), ~6 s restart
# USE_LLM / USE_VISION are only the starting choice; ./switch.sh (or saying
# "switch to Claude" to the robot) changes the active one in data/.
#   USE_LLM:    local | claude | openrouter | openrouter-free | huggingface | deepseek | custom
#   USE_VISION: local | claude | custom
USE_ASR=local
USE_LLM=local
USE_TTS=local
USE_VISION=local
# Spoken switching: "switch to Claude", "switch to local", "which brain are
# you using?". Handled on the voice server; nothing is added to the robot.
VOICE_SWITCH=true

# --- Cloud brains (LLM presets) -------------------------------------------
# Fill in the key of each one you want; a preset can't be chosen while its
# key is still "changeme". Keys live in .env only (git-ignored). After
# editing keys, run any ./switch.sh command: it re-renders and restarts once.

# Claude (console.anthropic.com). Paid per use.
#   claude-opus-5-5    most capable ($4 / $20 per million tokens in / out)
#   claude-sonnet-5-5  ($2 / $10)
#   claude-haiku-5-5   fastest and cheapest ($0.10 / $0.50)
ANTHROPIC_API_KEY=changeme
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_VISION_MODEL=claude-opus-5-5
# How hard Claude thinks before answering: low | medium | high. Low is the
# quickest, which suits speech.
CLAUDE_EFFORT=low

# OpenRouter (openrouter.ai/keys): one key, many models. Any id from
# openrouter.ai/models works.
OPENROUTER_API_KEY=changeme
OPENROUTER_MODEL=openrouter/auto
# The free preset. openrouter/free picks a free model that supports what the
# request needs (tools). Free models: 50 requests a day, or 1,000 a day once
# the account has bought $10 of credit.
OPENROUTER_FREE_MODEL=openrouter/free

# Hugging Face Inference Providers (token with "Make calls to Inference
# Providers"). Model ids are <org>/<model>, optionally :fastest, :cheapest
# or :<provider>. No free credit on a free account; PRO includes $2 a month.
HF_TOKEN=changeme
HF_MODEL=openai/gpt-oss-120b:fastest

# DeepSeek's own API (platform.deepseek.com). Paid, prepaid balance.
#   deepseek-flash   about $0.30 / $1.20 per million tokens in / out
#   deepseek-v4-pro  about $1.32 / $3.96
DEEPSEEK_API_KEY=changeme
DEEPSEEK_MODEL=deepseek-flash

# custom: any other OpenAI-compatible API.
CLOUD_LLM_URL=https://api.openai.com/v1
CLOUD_LLM_MODEL=gpt-4o-mini
CLOUD_LLM_API_KEY=changeme

# --- Cloud vision and speech-to-text ---------------------------------------
# Vision "claude" uses ANTHROPIC_API_KEY and CLAUDE_VISION_MODEL above.
# Vision "custom": any OpenAI-compatible API with image input.
CLOUD_VISION_URL=https://api.openai.com/v1
CLOUD_VISION_MODEL=gpt-4o-mini
CLOUD_VISION_API_KEY=changeme
# Cloud ASR: any OpenAI-compatible transcription API.
CLOUD_ASR_URL=https://api.openai.com/v1/audio/transcriptions
CLOUD_ASR_MODEL=gpt-4o-mini-transcribe
CLOUD_ASR_API_KEY=changeme
# Cloud TTS is Microsoft Edge TTS (free, no key); its voice is TTS_VOICE below.

# Kokoro image. Pin it by digest to keep the bundled voice models fixed:
#   KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu@sha256:<digest>
KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:latest

# Voice and language
# Local voice (Kokoro). Others: af_bella, af_nicole, am_adam, bf_emma ...
LOCAL_TTS_VOICE=af_heart
# Cloud voice (Edge TTS)
TTS_VOICE=en-US-AnaNeural
# Language the robot answers in (free text, passed to the LLM).
REPLY_LANGUAGE=English
ASR_LANGUAGE=auto
TIMEZONE_OFFSET=+0
