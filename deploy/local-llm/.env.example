# Copy to .env and edit, then run ./render-config.sh
#
# Where the xiaozhi server itself runs (the box that runs docker compose).
# Usually nuc3080 too. Use an IP if mDNS/hostnames don't resolve on the robot.
XIAOZHI_HOST=nuc3080
XIAOZHI_WS_PORT=8000
XIAOZHI_HTTP_PORT=8003

# Your local LLM. Any OpenAI-compatible endpoint works:
#   Ollama     http://nuc3080:11434/v1
#   llama.cpp  http://nuc3080:8080/v1
#   LM Studio  http://nuc3080:1234/v1
#   vLLM       http://nuc3080:8000/v1  (change XIAOZHI_WS_PORT if on the same box)
# If xiaozhi runs in Docker on the same machine as Ollama, "nuc3080" still works
# as long as the name resolves inside the container; otherwise use
# http://host.docker.internal:11434/v1 (mapped in docker-compose.yml).
LLM_URL=http://nuc3080:11434/v1
LLM_MODEL=qwen2.5:7b
# Ollama/llama.cpp ignore the key, but the client needs a non-empty value.
LLM_API_KEY=local

# Voice and language
TTS_VOICE=en-US-AnaNeural
ASR_LANGUAGE=auto
TIMEZONE_OFFSET=+0
