# Rendered into data/.config.yaml by render-config.sh. Only the keys here
# override the server's built-in config.yaml; everything else stays default.
# ${VARS} come from .env.

server:
  ip: 0.0.0.0
  port: ${XIAOZHI_WS_PORT}
  http_port: ${XIAOZHI_HTTP_PORT}
  # Address the OTA endpoint hands to the robot. Must be reachable from the robot.
  websocket: ws://${XIAOZHI_HOST}:${XIAOZHI_WS_PORT}/xiaozhi/v1/
  vision_explain: http://${XIAOZHI_HOST}:${XIAOZHI_HTTP_PORT}/mcp/vision/explain
  timezone_offset: ${TIMEZONE_OFFSET}
  auth:
    enabled: false

# Which backend each piece uses. ASR and TTS are set by USE_ASR / USE_TTS in
# .env (local or cloud). The LLM and vision go through a switchboard that
# holds every preset below and picks one per request, so they change with no
# restart: ./switch.sh llm claude
selected_module:
  VAD: SileroVAD
  ASR: ${SEL_ASR}
  LLM: Brain
  VLLM: Eyes
  TTS: ${SEL_TTS}
  Memory: nomem
  # function_call lets the LLM drive StackChan's MCP tools (head, LEDs, camera).
  # Needs a model with tool calling (the default qwen3.8-flash on nuc3080 does).
  # Use nointent if your model can't do tools.
  Intent: function_call

LLM:
  Brain:
    # providers/router: sends each request to the active preset. The active
    # name lives in data/llm-preset (written by ./switch.sh llm <name>, or by
    # saying "switch to Claude" to the robot); USE_LLM is the starting value.
    type: router
    default: ${USE_LLM}
    state_file: data/llm-preset
    # Answers a turn when the active brain fails before saying anything
    # (no internet, bad key). Remove the line to turn that off.
    fallback: local
    # Spoken switching ("switch to local", "which brain are you using?").
    # Handled on the server; adds nothing to the robot or its tool list.
    voice_switch: ${VOICE_SWITCH}
    presets:
      # The model on nuc3080. providers/llamacpp is the openai provider, but
      # it turns thinking off the way llama.cpp-style servers expect. Use
      # "type: openai" for other servers.
      local:
        label: my local brain
        says: [strata, offline, nuc]
        needs_key: false
        type: ${LLM_TYPE}
        url: ${LLM_URL}
        model_name: ${LLM_MODEL}
        api_key: ${LLM_API_KEY}
        thinking: "${LLM_THINKING}"
      # Claude through the official Anthropic SDK (providers/claude).
      claude:
        label: Claude
        says: [claud, clawd, clod, cloud]
        type: claude
        model_name: ${CLAUDE_MODEL}
        api_key: ${ANTHROPIC_API_KEY}
        effort: ${CLAUDE_EFFORT}
      openrouter:
        label: Open Router
        says: [open router]
        type: openai
        url: https://openrouter.ai/api/v1
        model_name: ${OPENROUTER_MODEL}
        api_key: ${OPENROUTER_API_KEY}
        thinking: keep
      # OpenRouter's free models: same key, 50 requests a day (1,000 with $10
      # of credit on the account).
      openrouter-free:
        label: Open Router free
        says: [open router free, free]
        type: openai
        url: https://openrouter.ai/api/v1
        model_name: ${OPENROUTER_FREE_MODEL}
        api_key: ${OPENROUTER_API_KEY}
        thinking: keep
      huggingface:
        label: Hugging Face
        says: [hugging face]
        type: openai
        url: https://router.huggingface.co/v1
        model_name: ${HF_MODEL}
        api_key: ${HF_TOKEN}
        thinking: keep
      # DeepSeek's own API (the openai provider turns its thinking off).
      deepseek:
        label: Deep Seek
        says: [deep seek]
        type: openai
        url: https://api.deepseek.com
        model_name: ${DEEPSEEK_MODEL}
        api_key: ${DEEPSEEK_API_KEY}
      # Any other OpenAI-compatible API.
      custom:
        label: my custom brain
        type: openai
        url: ${CLOUD_LLM_URL}
        model_name: ${CLOUD_LLM_MODEL}
        api_key: ${CLOUD_LLM_API_KEY}
        thinking: keep

# Vision: answers questions about a photo from the robot's camera.
VLLM:
  Eyes:
    # providers/vllm/router: like Brain. The active name lives in
    # data/vision-preset (./switch.sh vision <name>); USE_VISION starts it.
    type: router
    default: ${USE_VISION}
    state_file: data/vision-preset
    presets:
      # The same model on nuc3080 (it accepts images).
      local:
        type: llamacpp
        url: ${VISION_URL}
        model_name: ${VISION_MODEL}
        api_key: ${LLM_API_KEY}
        thinking: "${LLM_THINKING}"
        language: ${REPLY_LANGUAGE}
      claude:
        type: claude
        model_name: ${CLAUDE_VISION_MODEL}
        api_key: ${ANTHROPIC_API_KEY}
        effort: ${CLAUDE_EFFORT}
        language: ${REPLY_LANGUAGE}
      # Any other OpenAI-compatible API with image input.
      custom:
        type: llamacpp
        url: ${CLOUD_VISION_URL}
        model_name: ${CLOUD_VISION_MODEL}
        api_key: ${CLOUD_VISION_API_KEY}
        thinking: keep
        language: ${REPLY_LANGUAGE}

ASR:
  # local: SenseVoiceSmall on the CPU
  FunASR:
    type: fun_local
    model_dir: models/SenseVoiceSmall
    output_dir: tmp/
    language: ${ASR_LANGUAGE}
  # cloud: any OpenAI-compatible transcription API
  CloudASR:
    type: openai
    base_url: ${CLOUD_ASR_URL}
    model_name: ${CLOUD_ASR_MODEL}
    api_key: ${CLOUD_ASR_API_KEY}
    output_dir: tmp/

# "language" also sets the language the LLM is told to answer in (the stock
# default is Chinese), so every TTS entry carries it.
TTS:
  # local: Kokoro in the kokoro-tts container (OpenAI-compatible speech API)
  LocalTTS:
    type: openai
    api_url: http://kokoro-tts:8880/v1/audio/speech
    api_key: local
    model: kokoro
    voice: ${LOCAL_TTS_VOICE}
    format: wav
    speed: 1
    output_dir: tmp/
    language: ${REPLY_LANGUAGE}
  # cloud: Microsoft Edge TTS (free, no key, needs internet)
  EdgeTTS:
    type: edge
    voice: ${TTS_VOICE}
    output_dir: tmp/
    language: ${REPLY_LANGUAGE}

# Only StackChan's own tools (sent by the robot over MCP) plus the built-in
# exit tool. The stock list adds weather/news/search plugins that need
# Chinese web services and make the first prompt much longer.
Intent:
  function_call:
    type: function_call
    functions: []

# Compact English system prompt wrapper (copied to data/ by render-config.sh).
# The stock one is long and full of Chinese examples, which slows the first
# reply and nudges the model toward Chinese.
prompt_template: data/agent-prompt.txt

prompt: |
  You are StackChan, a small desktop robot with a face on a screen and a head
  that can pan and tilt. You are friendly, curious and a little playful.
  Keep answers short (one to three sentences) because they are spoken aloud.
  Use your tools to move your head or change your LEDs when it fits the moment.
  Only use the camera when asked what you can see.

end_prompt:
  enable: true
  prompt: |
    Say a short, warm goodbye in one sentence.

system_error_response: "Sorry, my brain is a bit busy right now. Try again in a moment."
exit_commands:
  - "goodbye"
  - "go to sleep"
