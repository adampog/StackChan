# Rendered into data/.config.yaml by render-config.sh. Only the keys here
# override the server's built-in config.yaml; everything else stays default.
# ${VARS} come from .env.

server:
  ip: 0.0.0.0
  port: ${XIAOZHI_WS_PORT}
  http_port: ${XIAOZHI_HTTP_PORT}
  # Address the OTA endpoint hands to the robot. Must be reachable from the robot.
  websocket: ws://${XIAOZHI_HOST}:${XIAOZHI_WS_PORT}/xiaozhi/v1/
  vision_explain: http://${XIAOZHI_HOST}:${XIAOZHI_HTTP_PORT}/mcp/vision/explain
  timezone_offset: ${TIMEZONE_OFFSET}
  auth:
    enabled: false

# Which backend each piece uses. Set by USE_ASR / USE_LLM / USE_TTS /
# USE_VISION in .env (local or cloud); change them with ./switch.sh.
selected_module:
  VAD: SileroVAD
  ASR: ${SEL_ASR}
  LLM: ${SEL_LLM}
  VLLM: ${SEL_VLLM}
  TTS: ${SEL_TTS}
  Memory: nomem
  # function_call lets the LLM drive StackChan's MCP tools (head, LEDs, camera).
  # Needs a model with tool calling (the default qwen3.8-flash on nuc3080 does).
  # Use nointent if your model can't do tools.
  Intent: function_call

LLM:
  # local
  NucLLM:
    # providers/llamacpp: the openai provider, but it turns thinking off the
    # way llama.cpp-style servers expect. Use "type: openai" for other servers.
    type: ${LLM_TYPE}
    url: ${LLM_URL}
    model_name: ${LLM_MODEL}
    api_key: ${LLM_API_KEY}
    thinking: "${LLM_THINKING}"
  # cloud: any OpenAI-compatible API
  CloudLLM:
    type: openai
    url: ${CLOUD_LLM_URL}
    model_name: ${CLOUD_LLM_MODEL}
    api_key: ${CLOUD_LLM_API_KEY}
    thinking: keep

# Vision: answers questions about a photo from the robot's camera.
VLLM:
  # local: the same model on nuc3080 (it accepts images)
  NucVLLM:
    type: llamacpp
    url: ${VISION_URL}
    model_name: ${VISION_MODEL}
    api_key: ${LLM_API_KEY}
    thinking: "${LLM_THINKING}"
    language: ${REPLY_LANGUAGE}
  CloudVLLM:
    type: llamacpp
    url: ${CLOUD_VISION_URL}
    model_name: ${CLOUD_VISION_MODEL}
    api_key: ${CLOUD_VISION_API_KEY}
    thinking: keep
    language: ${REPLY_LANGUAGE}

ASR:
  # local: SenseVoiceSmall on the CPU
  FunASR:
    type: fun_local
    model_dir: models/SenseVoiceSmall
    output_dir: tmp/
    language: ${ASR_LANGUAGE}
  # cloud: any OpenAI-compatible transcription API
  CloudASR:
    type: openai
    base_url: ${CLOUD_ASR_URL}
    model_name: ${CLOUD_ASR_MODEL}
    api_key: ${CLOUD_ASR_API_KEY}
    output_dir: tmp/

# "language" also sets the language the LLM is told to answer in (the stock
# default is Chinese), so every TTS entry carries it.
TTS:
  # local: Kokoro in the kokoro-tts container (OpenAI-compatible speech API)
  LocalTTS:
    type: openai
    api_url: http://kokoro-tts:8880/v1/audio/speech
    api_key: local
    model: kokoro
    voice: ${LOCAL_TTS_VOICE}
    format: wav
    speed: 1
    output_dir: tmp/
    language: ${REPLY_LANGUAGE}
  # cloud: Microsoft Edge TTS (free, no key, needs internet)
  EdgeTTS:
    type: edge
    voice: ${TTS_VOICE}
    output_dir: tmp/
    language: ${REPLY_LANGUAGE}

# Only StackChan's own tools (sent by the robot over MCP) plus the built-in
# exit tool. The stock list adds weather/news/search plugins that need
# Chinese web services and make the first prompt much longer.
Intent:
  function_call:
    type: function_call
    functions: []

# Compact English system prompt wrapper (copied to data/ by render-config.sh).
# The stock one is long and full of Chinese examples, which slows the first
# reply and nudges the model toward Chinese.
prompt_template: data/agent-prompt.txt

prompt: |
  You are StackChan, a small desktop robot with a face on a screen and a head
  that can pan and tilt. You are friendly, curious and a little playful.
  Keep answers short (one to three sentences) because they are spoken aloud.
  Use your tools to move your head or change your LEDs when it fits the moment.
  Only use the camera when asked what you can see.

end_prompt:
  enable: true
  prompt: |
    Say a short, warm goodbye in one sentence.

system_error_response: "Sorry, my brain is a bit busy right now. Try again in a moment."
exit_commands:
  - "goodbye"
  - "go to sleep"
